{
  "name": "stellar-sdk-utils",
  "version": "2.1.0",
  "description": "Production-ready utilities for Stellar blockchain development",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx watch src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.{ts,js,json}",
    "docs": "typedoc src/index.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "stellar",
    "blockchain",
    "cryptocurrency",
    "transaction",
    "validation",
    "horizon",
    "sdk",
    "utilities"
  ],
  "author": "Stellar Development Foundation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/stellar/stellar-sdk-utils.git"
  },
  "bugs": {
    "url": "https://github.com/stellar/stellar-sdk-utils/issues"
  },
  "homepage": "https://github.com/stellar/stellar-sdk-utils#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@stellar/stellar-sdk": "^11.2.0",
    "axios": "^1.6.0",
    "eventemitter3": "^5.0.1",
    "p-retry": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/jest": "^29.5.6",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "ts-jest": "^29.1.1",
    "tsx": "^3.14.0",
    "typedoc": "^0.25.3",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}