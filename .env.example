# Blockchain Bridge Validator Environment Configuration
# Copy this file to .env and update the values

# Application Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Stellar Network Configuration
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org

# Optimism Network Configuration  
OPTIMISM_RPC_URL=https://goerli.optimism.io
OPTIMISM_CHAIN_ID=420

# Bridge Contract Configuration (example addresses)
BRIDGE_CONTRACT_ADDRESS=0x742d35Cc6634C0532925a3b8D431736C456A

# API Configuration
API_KEY_REQUIRED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Cache Configuration (Redis)
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# Database Configuration (optional)
DATABASE_URL=postgresql://user:pass@localhost:5432/bridge_validator

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090